# ==============================================================================
# Environment Configuration
# Note: Dev & Local are the same environment (APP_ENV=local)
# ==============================================================================
APP_ENV=local

# ------------------------------------------------------------------------------
# Nginx Configuration
# Default NGINX_PORT is 8088 to avoid host port collisions (e.g. port 80).
# Change to 80 if port 80 is available on your machine.
# ------------------------------------------------------------------------------
NGINX_PORT=8088
NGINX_SSL_PORT=8443

# ------------------------------------------------------------------------------
# Server (Golang 1.26 API Backend) Configuration
# ------------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
SERVER_PORT_EXTERNAL=8090
JWT_SECRET=food_app_dev_jwt_secret_key_2026_very_secure_string_min_32_bytes

# ------------------------------------------------------------------------------
# Database (PostgreSQL 18) Configuration
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_PORT_EXTERNAL=5432
DB_NAME=food_db
DB_USER=food_user
DB_PASSWORD=food_secret
DB_SSLMODE=disable
